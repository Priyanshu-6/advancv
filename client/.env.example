# ---------------------------------------------------------------------------
# AdvanCV client environment
# Copy to `.env` and fill in. Only VITE_-prefixed vars reach the browser.
# Never put secrets here — anything in this file is public once built.
# ---------------------------------------------------------------------------

# Base URL of the AdvanCV API.
VITE_API_URL=http://localhost:5001

# Google OAuth *client ID* (public by design — the client secret stays server-side).
# Must match GOOGLE_CLIENT_ID in server/.env.
# The client also falls back to fetching this from GET /api/auth/config,
# so setting it here is optional.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

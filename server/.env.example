# ---------------------------------------------------------------------------
# AdvanCV server environment
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=5001
NODE_ENV=development

# Comma-separated list of allowed browser origins (the Vite dev server, plus
# your deployed frontend URL in production).
CLIENT_ORIGINS=http://localhost:5173

# Public base URL of the frontend. Used to build shareable resume links.
CLIENT_URL=http://localhost:5173

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/advancv
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/advancv?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/advancv

# Secret used to sign session JWTs. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Google OAuth. Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"). Add your client origin to
# "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
